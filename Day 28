Problem: Circular Linked List Creation and Traversal - Implement using linked list with dynamic memory allocation.

Input:
- First line: integer n
- Second line: n space-separated integers

Output:
- Print the circular linked list elements starting from head, space-separated

Example:
Input:
5
10 20 30 40 50

Output:
10 20 30 40 50

Explanation:
Last node's next points to head. Traverse from head until returning to head to avoid infinite loop.


CODE-

#include <stdio.h>
#include <stdlib.h>

// Define the node structure
struct Node {
    int data;
    struct Node* next;
};

// Function to create the circular linked list
struct Node* createList(int n) {
    if (n <= 0) return NULL;

    struct Node *head = NULL, *prev = NULL;

    for (int i = 0; i < n; i++) {
        // Dynamically allocate memory for each node
        struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
        scanf("%d", &newNode->data);

        if (head == NULL) {
            head = newNode;
        } else {
            prev->next = newNode;
        }
        
        prev = newNode;
        // The last node added always points back to head to keep it circular
        prev->next = head; 
    }
    return head;
}

// Function to traverse and print the list
void display(struct Node* head) {
    if (head == NULL) return;

    struct Node* temp = head;
    // Use a do-while loop to ensure the head is printed before the condition check
    do {
        printf("%d ", temp->data);
        temp = temp->next;
    } while (temp != head);
    
    printf("\n");
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;

    struct Node* head = createList(n);
    display(head);

    return 0;
}
